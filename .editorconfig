# ============================================================
# EDITORCONFIG — konsistensi penulisan (Fase 11 B5)
# https://editorconfig.org
# ============================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# Markdown memakai dua spasi di akhir baris sebagai <br>
trim_trailing_whitespace = false

[*.json]
indent_size = 2

[*.{js,css}]
indent_size = 2

# Skrip Windows butuh CRLF
[*.{bat,cmd}]
end_of_line = crlf
