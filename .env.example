# ============================================================
# KREDENSIAL & API KEY — salin ke .env lalu isi nilainya.
# File .env TIDAK boleh di-commit ke repository.
# ============================================================

# Database (user MySQL khusus, hak terbatas SELECT/INSERT/UPDATE/DELETE)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_spmb_mualimku
DB_USER=spmb_app
DB_PASS=ISI_PASSWORD_SPMB_APP_DISINI

# Fonnte WhatsApp Gateway
FONNTE_TOKEN=

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SANDBOX=1

# URL publik aplikasi (Fase 10) — dipakai url_abs() utk tautan di WhatsApp/email.
# Isi dengan domain asli di production, mis. https://spmb.smpm5.sch.id
# Biarkan kosong di localhost (otomatis deteksi dari request).
APP_URL=

# --- Proxy tepercaya (Fase 12 C3) ---
# Kosong = TIDAK ada proxy tepercaya; semua header X-Forwarded-For /
# CF-Connecting-IP DIABAIKAN (perilaku aman default).
# Isi bila aplikasi berada di belakang Cloudflare / load balancer:
# daftar CIDR atau IP tunggal dipisah koma, mis. 192.0.2.10,2001:db8::/32
# Daftar CIDR Cloudflare: salin dari HALAMAN RESMI Cloudflare
# (https://www.cloudflare.com/ips/) — jangan mengandalkan daftar luar yang basi.
TRUSTED_PROXIES=
# Header yang dipakai: X-Forwarded-For (default) atau CF-Connecting-IP
# (nilai kosong = X-Forwarded-For).
TRUSTED_PROXY_HEADER=
