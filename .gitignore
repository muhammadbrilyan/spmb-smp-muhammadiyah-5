# Jangan commit kredensial & API key
.env
hak akses.txt

# Unggahan pribadi (KK, akta, bukti transfer) — data sensitif
storage/dokumen/*
!storage/dokumen/.gitkeep
# Berkas contoh seed demo (PNG 4px netral, Fase 11 B6)
!storage/dokumen/dok-demo-*.png
!storage/dokumen/bukti-demo-*.png

# Hasil cadangan (Fase 11 B3) — data sensitif
storage/backup/*
!storage/backup/.gitkeep

# Cadangan mysqldump manual sebelum migrasi DB — data sensitif, tidak untuk repo
database/backup/*
!database/backup/.gitkeep

# Backup / file sementara
*.bak
*.old
*.swp
*~
tmp-*
*.log

# Output paket rilis (Fase 11 B1)
dist/

# OS
Thumbs.db
.DS_Store

# Dependensi build CSS (npm install)
node_modules/
